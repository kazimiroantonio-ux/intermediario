# ==============================================================================
# O INTERMEDIÁRIO — Variáveis de Ambiente
# ==============================================================================
# Copia este ficheiro para .env e substitui todos os <SUBSTITUIR>.
# Em produção, define estas variáveis no painel do host (AngoWeb cPanel / PaaS).
# NUNCA commites o .env no repositório.
# ==============================================================================

# ==============================================================================
# BASE DE DADOS (Supabase)
# ==============================================================================
# Obtém em: Dashboard → Project Settings → Database → aba "Connection string"
# DATABASE_URL = Transaction pooler (porta 6543) — usado pelo runtime/app (adapter-pg).
#   O nome do utilizador usa o formato postgres.<project-ref>.
# DIRECT_URL = Session pooler (porta 5432) — usado pelas migrações/CLI do Prisma (suporta DDL).
#   NOTA: se a máquina não tiver IPv6, usar o pooler aws-0-<regiao>.pooler.supabase.com
#   em vez de db.<project-ref>.supabase.co (este resolve só IPv6).
# DATABASE_URL=<SUBSTITUIR: pooler transaction porta 6543>
DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-PASSWORD>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres
# DIRECT_URL=<SUBSTITUIR: session pooler porta 5432>
DIRECT_URL=postgresql://postgres.<project-ref>:<YOUR-PASSWORD>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres

# ==============================================================================
# AUTENTICAÇÃO (better-auth)
# ==============================================================================
# Obtém em: gera com `openssl rand -base64 32` (mínimo 32 bytes).
# Obrigatório em produção — sem isso, o servidor lança BetterAuthError.
BETTER_AUTH_SECRET=<SUBSTITUIR: segredo forte, mínimo 32 bytes>

# Obtém em: o teu domínio final com https:// (ex.: https://www.ointermediario.ao).
# Usado para links de verificação de email, callbacks e cookies.
BETTER_AUTH_URL=<SUBSTITUIR: https://dominio.com>

# Lista separada por vírgulas de origens extras aceites para CORS/CSRF.
# Usar se o domínio público for diferente do BETTER_AUTH_URL.
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.dominio.com,https://marketing.dominio.com

# ==============================================================================
# DOMÍNIO / APP (frontend)
# ==============================================================================
# Obtém em: o teu domínio final (ex.: https://www.ointermediario.ao).
NEXT_PUBLIC_APP_URL=<SUBSTITUIR: https://dominio.com>

# ==============================================================================
# SUPABASE (Realtime + Storage)
# ==============================================================================
# Obtém em: Dashboard → Project Settings → API
# URL do projeto (ex.: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=<SUBSTITUIR: https://xxxx.supabase.co>
# Chave anon/publishable — segura para o cliente (browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUBSTITUIR: sb_publishable_...>
# Chave service_role — APENAS no servidor (rotas de API). NUNCA expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=<SUBSTITUIR: sb_secret_...>

# ==============================================================================
# SMS / OTP (KambaSMS — Angola)
# ==============================================================================
# Obtém em: https://kambasms.ao/dashboard/keys
# Formato da chave: kamba_xxxxxxxxxxxxxxxx
# Sender ID: definido no dashboard ao criar a chave (ex.: "INTERMEDIARIO")
# O endpoint OTP (/otp/send) gera e valida o código automaticamente.
# Nota: números devem estar no formato +2449XXXXXXXX.
KAMBA_API_KEY=<SUBSTITUIR: kamba_xxxxxxxxxxxxxxxx>
# KAMBA_SENDER_ID=<SUBSTITUIR: sender id definido no dashboard KambaSMS>

# ==============================================================================
# EMAIL (Brevo — transacional)
# ==============================================================================
# Obtém em: Brevo (antigo Sendinblue) → Settings → SMTP & API → API Keys
# Sem esta chave, os e-mails de verificação/recuperação ficam ignorados (warn no console).
BREVO_API_KEY=<SUBSTITUIR>
# Obtém em: Brevo → Contacts → Senders (deve ser um e-mail verificado no Brevo).
BREVO_SENDER_EMAIL=<SUBSTITUIR: ex.: noreply@ointermediario.ao>
BREVO_SENDER_NAME=O Intermediário

# ==============================================================================
# PAGAMENTOS (Multicaixa Express / ProxyPay / EMIS)
# ==============================================================================
# Obtém em: painel ProxyPay/EMIS ou junto do banco parceiro.
# Entidade Multicaixa Express (número da empresa no Multicaixa).
MULTICAIXA_ENTITY=<SUBSTITUIR>
# Segredo para validação de webhooks HMAC-SHA256 (x-gateway-signature).
MULTICAIXA_WEBHOOK_SECRET=<SUBSTITUIR>

# ==============================================================================
# ARMAZENAMENTO DE IMAGENS
# ==============================================================================
# "local" (default — ficheiros em public/uploads/), "cloudinary" ou "s3" (futuro).
STORAGE_PROVIDER=local

# Cloudinary: obtém em https://console.cloudinary.com → Dashboard
# Requer STORAGE_PROVIDER=cloudinary.
CLOUDINARY_CLOUD_NAME=<SUBSTITUIR>
# Upload preset: Settings → Upload → Upload presets → criar um "Unsigned" preset.
CLOUDINARY_UPLOAD_PRESET=<SUBSTITUIR>

# ==============================================================================
# SERVIDOR (normalmente definido pelo host; raramente necessário definir)
# ==============================================================================
# PORT=3000
# NODE_ENV=production

# ==============================================================================
# SEGURANÇA — NUNCA definir como "true" em produção
# ==============================================================================
# DISABLE_ORIGIN_CHECK=true

# ==============================================================================
# SEED / DEMO (apenas para popular dados de teste)
# ==============================================================================
# SEED_BASE_URL=http://localhost:3000
